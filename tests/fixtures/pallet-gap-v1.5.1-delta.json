      "before": "            <label>\n              <span data-i18n=\"pallet.gap\">pallet.gap</span>\n              <span class=\"measurement-input\">\n                <input id=\"gap\" data-length-input data-min-mm=\"0\" data-mm=\"0\" type=\"text\" inputmode=\"decimal\" value=\"0\" required>\n                <span class=\"unit-suffix\" data-unit-suffix aria-hidden=\"true\">mm</span>\n              </span>\n            </label>",
      "after": "            <div class=\"gap-setting\">\n              <label>\n                <span id=\"gapLabel\" data-i18n=\"pallet.gap\">pallet.gap</span>\n                <span class=\"measurement-input\">\n                  <input id=\"gap\" aria-describedby=\"gapHelp\" data-length-input data-min-mm=\"0\" data-mm=\"0\" type=\"text\" inputmode=\"decimal\" value=\"0\" required>\n                  <span class=\"unit-suffix\" data-unit-suffix aria-hidden=\"true\">mm</span>\n                </span>\n              </label>\n              <button class=\"gap-info\" type=\"button\" popovertarget=\"gapHelp\" aria-labelledby=\"gapLabel\" aria-describedby=\"gapHelp\"><span aria-hidden=\"true\">i</span></button>\n              <div id=\"gapHelp\" popover=\"auto\" role=\"tooltip\" data-i18n=\"pallet.gapHelp\">pallet.gapHelp</div>\n            </div>",
      "count": 1
    },
    {
      "before": "    /* C4e UX01: align stacking controls and allow full numeric text height. */",
      "after": "    /* v1.5.1: short pallet-gap label with an accessible, non-layout popover. */\n    #planner .gap-setting { position: relative; display: grid; min-width: 0; }\n    #planner .gap-setting #gapLabel { padding-inline-end: 28px; }\n    #planner .gap-setting .gap-info { position: absolute; inset-inline-end: 0; top: -3px; display: grid; place-items: center; width: 24px; min-width: 24px; height: 24px; min-height: 24px; padding: 0; border: 0; border-radius: 4px; background: transparent; color: var(--lc-text-secondary); }\n    #planner .gap-info > span { display: grid; place-items: center; width: 14px; height: 14px; border: 1px solid currentColor; border-radius: 50%; font: 600 11px/1 sans-serif; }\n    #planner .gap-info:hover { background: var(--lc-selected-bg); }\n    #planner .gap-info:focus-visible { outline: 2px solid var(--lc-focus); outline-offset: 2px; }\n    #gapHelp { box-sizing: border-box; position: fixed; inset: 0; margin: auto; width: max-content; max-width: calc(100vw - 32px); height: max-content; padding: 12px 14px; border: 1px solid var(--lc-border); border-radius: 6px; background: var(--lc-tooltip-bg); color: var(--lc-tooltip-text); box-shadow: 0 4px 18px rgba(0,0,0,.18); font-size: 14px; line-height: 1.5; overflow-wrap: anywhere; }\n    @supports (position-area: bottom) {\n      #planner .gap-info { anchor-name: --pallet-gap-info; }\n      #gapHelp { position-anchor: --pallet-gap-info; position-area: bottom span-left; position-try-fallbacks: flip-inline, flip-block; inset: auto; margin: 6px 0 0; max-width: min(340px, calc(100vw - 32px)); }\n    }\n    /* C4e UX01: align stacking controls and allow full numeric text height. */",
      "count": 1
    },
    {

  "patches": [
    {
      "before": "",
      "after": "      #planner .unit-preference { display: block; width: min(229px,100%); }\n      #planner .unit-preference legend { position: static; margin: 0 0 var(--planner-label-gap); }\n"
    },
    {
      "before": "                <span data-i18n=\"preview.display\">preview.display</span>\n                <select id=\"drawSelect\"></select>\n",
      "after": "                <span id=\"drawSelectLabel\" data-i18n=\"preview.display\">preview.display</span>\n                <select id=\"drawSelect\" aria-labelledby=\"drawSelectLabel\"></select>\n"
    },
    {
      "before": "",
      "after": "      const warehouseNoteKey = result.advancedStacking\n        ? (result.stacks?.some(stack => stack.layers.length > 1) ? \"advanced.warehouseNote\" : \"advanced.warehouseNoteFloor\")\n        : result.mode === \"mixed\" ? \"print.warehouseNoteMixed\"\n        : result.layout.rects.some(rect => rect.stackCount > 1) ? \"print.warehouseNoteLayers\"\n        : \"print.warehouseNoteFloor\";\n"
    },
    {
      "before": "              <div class=\"warehouse-note\">${escapeHtml(t(result.stacks ? \"advanced.warehouseNote\" : \"print.warehouseNote\"))}</div>\n",
      "after": "              <div class=\"warehouse-note\">${escapeHtml(t(warehouseNoteKey))} ${escapeHtml(t(\"print.warehouseNote\"))}</div>\n"
    }
  ],

{
  "name": "loadcomposer",
  "private": true,
  "version": "1.2.1",
  "description": "Browser-based geometric load-planning estimator with offline and standalone support.",
  "type": "module",
  "license": "LicenseRef-LoadComposer-Community-1.0",
  "author": "Marco Pernigotti",
  "homepage": "https://loadcomposer.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LoadComposer/loadcomposer.git"
  },
  "bugs": {
    "url": "https://github.com/LoadComposer/loadcomposer/issues"
  },
  "engines": {
    "node": "^22.17.0 || >=24.0.0"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build:standalone": "node scripts/build-standalone.mjs",
    "build:legal": "node scripts/prepare-site-legal.mjs",
    "build:standalone-package": "node scripts/package-standalone.mjs",
    "build:glossary": "node scripts/generate-translation-glossary.mjs",
    "build:assets": "node scripts/prepare-release-assets.mjs",
    "build:downloads": "node scripts/build-downloads-page.mjs",
    "build:404": "node scripts/build-404-page.mjs",
    "build": "npm run build:standalone && npm run build:legal && npm run build:standalone-package && npm run build:downloads && npm run build:404 && npm run build:glossary && npm run build:assets",
    "check:glossary": "node scripts/generate-translation-glossary.mjs --check",
    "check:i18n-js": "node tests/check-js-syntax-i18n-v1.0.0.mjs",
    "check:js": "node tests/check-js-syntax-i18n-v1.0.0.mjs",
    "check:node": "node tests/check-node-syntax-v1.0.0.mjs",
    "test:catalogs": "node tests/i18n-catalogs-v1.0.0.mjs",
    "test:plural-audit": "node tests/i18n-plural-source-audit-v1.0.0.mjs",
    "test:plural-engine": "node tests/i18n-plural-engine-v1.0.0.mjs",
    "test:quantity-rendering": "node tests/i18n-quantity-rendering-v1.0.0.mjs",
    "test:i18n": "node tests/i18n-modular-v1.0.0.mjs",
    "test:scope-freeze": "node tests/scope-freeze-v1.0.0.mjs",
    "test:scope-audit": "node tests/v12-scope-audit-v1.2.0.mjs && node tests/v121-scope-audit-v1.2.1.mjs",
    "test:community-feedback": "node tests/community-feedback-v1.2.0.mjs",
    "test:downloads": "node tests/downloads-page-v1.2.1.mjs",
    "test:remaining-space": "node tests/remaining-space-v1.2.0.mjs",
    "test:ui-v121": "node tests/ui-consistency-v1.2.1.mjs",
    "test:trailer-prudential": "node tests/trailer-prudential-alerts-v1.0.0.mjs",
    "test:cache-policy": "node tests/cache-policy-v1.0.0.mjs",
    "test:legal-inline": "node tests/legal-inline-v1.0.0.mjs",
    "test:legal-page": "node tests/legal-page-v1.2.1.mjs",
    "test:404": "node tests/404-page-v1.2.1.mjs",
    "test:404-scope": "node tests/v121-404-finalization-scope-audit.mjs",
    "test:orientation-audit": "node tests/orientation-source-audit-v1.0.0.mjs",
    "test:visual-refinements": "node tests/visual-refinements-v1.0.0.mjs",
    "test:i18n-visual": "node tests/i18n-visual-responsive-v1.0.0.mjs",
    "test:parity": "node tests/functional-parity-v1.0.0.mjs",
    "test:geometry": "node tests/geometry-full-parity-v1.0.0.mjs",
    "test:version": "node tests/version-consistency-v1.0.0.mjs",
    "test:security": "LOADCOMPOSER_HTML=site/downloads/loadcomposer-v1.2.1-standalone.html node tests/security-xss-v1.0.0.mjs",
    "test:regression": "LOADCOMPOSER_HTML=site/downloads/loadcomposer-v1.2.1-standalone.html node tests/loadcomposer-regression-v1.0.0.mjs",
    "test:events": "LOADCOMPOSER_EVENT_BASELINE=tests/fixtures/baseline-v1.2.0/loadcomposer-v1.2.0-standalone.html LOADCOMPOSER_HTML=site/downloads/loadcomposer-v1.2.1-standalone.html node tests/event-audit-v1.0.0.mjs",
    "test:responsive": "LOADCOMPOSER_HTML=site/downloads/loadcomposer-v1.2.1-standalone.html node tests/responsive-v1.0.0.mjs",
    "test:print-i18n": "LOADCOMPOSER_HTML=site/downloads/loadcomposer-v1.2.1-standalone.html LOADCOMPOSER_LOCALE=it-IT PRINT_OUTPUT_ROOT=print-evidence-v1.2.1 PRINT_RESULT_NAME=print-results-v1.2.1.json node tests/print-pdf-v1.0.0.mjs",
    "test:print-parity": "node tests/compare-print-renders-v1.0.0.mjs",
    "test:print-locales": "node tests/print-i18n-locales-v1.0.0.mjs",
    "test:print-plurals": "node tests/print-plural-scenarios-v1.0.0.mjs",
    "test:repository": "node tests/repository-release-audit-v1.0.0.mjs",
    "test:runtime": "node tests/repository-runtime-v1.0.0.mjs",
    "test:hardening": "node tests/hardening-audit-v1.0.0.mjs",
    "test:workflow-policy": "node tests/workflow-policy-v1.0.0.mjs",
    "test:delivery": "node tests/delivery-packaging-v1.2.1.mjs",
    "test:legacy": "npm run test:version && npm run test:regression && npm run test:security && npm run test:events && npm run test:responsive",
    "test": "npm run build && npm run check:glossary && npm run check:i18n-js && npm run check:js && npm run check:node && npm run test:catalogs && npm run test:plural-audit && npm run test:plural-engine && npm run test:quantity-rendering && npm run test:i18n && npm run test:scope-freeze && npm run test:scope-audit && npm run test:404-scope && npm run test:community-feedback && npm run test:downloads && npm run test:remaining-space && npm run test:ui-v121 && npm run test:trailer-prudential && npm run test:cache-policy && npm run test:legal-inline && npm run test:legal-page && npm run test:404 && npm run test:orientation-audit && npm run test:repository && npm run test:runtime && npm run test:hardening && npm run test:workflow-policy && npm run test:visual-refinements && npm run test:i18n-visual && npm run test:parity && npm run test:geometry && npm run test:legacy && npm run test:print-i18n && npm run test:print-parity && npm run test:print-locales && npm run test:print-plurals"
  },
  "devDependencies": {
    "@sparticuz/chromium": "149.0.0",
    "jsdom": "29.1.1",
    "playwright-core": "1.61.1",
    "tar-fs": "3.1.3"
  }
}
